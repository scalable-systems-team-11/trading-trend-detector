# Copy to .env and uncomment what you want to change; docker compose reads .env automatically.
# Defaults are in docker-compose.yml.
# Keep comments on their own lines: "KEY=  # comment" makes the comment the value.

## Replayer
# Space-separated, paths inside the container
# REPLAY_FILES=/data/debs2022-gc-trading-day-08-11-21.csv
# 0 = as fast as possible
# REPLAY_SPEED=60
# REPLAY_ONLY_PRICES=1
# Leave empty (REPLAY_START=) for the whole day
# REPLAY_START=08:00
# REPLAY_END=
# e.g. SIE.ETR,ENGI.FR (reduces input)
# REPLAY_SYMBOLS=
# Stop after N events, 0 = no limit
# REPLAY_LIMIT=0

## Receiver
# RECEIVER_ALLOWED_LATENESS_SECONDS=0
# RECEIVER_FLUSH_PARTIAL=0
# Only output these symbols (all are still calculated)
# RECEIVER_SYMBOLS=
